*HCAP Domain-specific cognition;
proc import datafile="D:\Database\HRS\HCAP\HC16summary\HC16HP_F.sav" out=HCAP_summary replace;run;
proc sort data=HRS_final;by HHID PN;run;
proc sort data=HCAP_summary;by HHID PN;run;
data HCAP_summary2;
set HCAP_summary;
/* PV-based HRS-HCAP factor scores: mean=50, SD=10 in the HRS-HCAP sample */
hcap_gcp_z=(vs5gcp_pv-50)/10;
hcap_mem_z=(vs4mem_pv-50)/10;
hcap_exf_z=(vs4exf_pv-50)/10;
hcap_lfl_z=(vs4lfl_pv-50)/10;
if cmiss(hcap_gcp_z,hcap_mem_z,hcap_exf_z,hcap_lfl_z)=0;
keep HHID PN vs5gcp_pv vs4mem_pv vs4exf_pv vs4lfl_pv hcap_gcp_z hcap_mem_z hcap_exf_z hcap_lfl_z;
run;
proc means data=HCAP_summary2 n mean std min max;
var hcap_gcp_z hcap_mem_z hcap_exf_z hcap_lfl_z;
run;
data HRS_HCAP;
merge HRS_final(in=a) HCAP_summary2(in=b);
by HHID PN;
if a and b;
run;
