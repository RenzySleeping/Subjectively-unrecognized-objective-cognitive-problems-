var z_score_CSP z_score_CellAge z_score_Dunkley z_score_GO z_score_Garcia z_score_KEGG z_score_SIP z_score_SRP z_score_SenMayo z_score_SenescenceSummary;
run;
proc standard data=AgingRNA mean=0 std=1 out=AgingRNA2;
var z_score_CSP z_score_CellAge z_score_Dunkley z_score_GO z_score_Garcia z_score_KEGG z_score_SIP z_score_SRP z_score_SenMayo z_score_SenescenceSummary;
run;
data HRS_AgingRNA;
merge HRS_final(in=a) AgingRNA2(in=b);
by HHID PN;
if a and b;
run;
proc means data=HRS_AgingRNA n mean std min max;
var z_score_CSP z_score_CellAge z_score_Dunkley z_score_GO z_score_Garcia z_score_KEGG z_score_SIP z_score_SRP z_score_SenMayo z_score_SenescenceSummary;
run;
proc means data=HRS_AgingRNA n mean std;
class cogmem_grp;
var z_score_CSP z_score_CellAge z_score_Dunkley z_score_GO z_score_Garcia z_score_KEGG z_score_SIP z_score_SRP z_score_SenMayo z_score_SenescenceSummary;
run;

*Canonical senescence pathway;
proc genmod data=HRS_AgingRNA;
where z_score_CSP ne .;
class cogmem_grp(ref='Obj Normal; Sub Normal') &class/param=ref;
model z_score_CSP=cogmem_grp &covariate/dist=normal link=identity;
ods select ParameterEstimates;
run;
proc genmod data=HRS_AgingRNA;
where z_score_CSP ne .;
class cogmem_grp(ref='Obj Normal; Sub Normal') &class/param=ref;
model z_score_CSP=cogmem_grp|age &covariate/dist=normal link=identity;
ods select ParameterEstimates;
run;
proc genmod data=HRS_AgingRNA;
where age<65 and z_score_CSP ne .;
class cogmem_grp(ref='Obj Normal; Sub Normal') &class/param=ref;
model z_score_CSP=cogmem_grp &covariate/dist=normal link=identity;
ods select ParameterEstimates;
run;
proc genmod data=HRS_AgingRNA;
where age>=65 and z_score_CSP ne .;
class cogmem_grp(ref='Obj Normal; Sub Normal') &class/param=ref;
model z_score_CSP=cogmem_grp &covariate/dist=normal link=identity;
ods select ParameterEstimates;
run;

